# Group names follow PRD 6.3. The full GitLab group path is open (PRD Q-01).
# The last matching pattern wins.

*                                  @editors

# Schemas and taxonomy: maintainers merge, editors review.
/schemas/                          @maintainers
/taxonomy/                         @maintainers

# Evaluative-term list, publisher grades and sensitive-term list: a senior editor must approve.
/taxonomy/banned_terms.yaml        @senior-editors
/taxonomy/publisher_grades.yaml    @senior-editors
/taxonomy/sensitive_terms.yaml     @senior-editors

# Central jurisdiction file is hand-written (D17).
/jurisdictions/jur-tw.yaml         @maintainers

# Takedown and privacy records
/corrections/                      @senior-editors
