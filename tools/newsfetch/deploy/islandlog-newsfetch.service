# Daily news layer (T79, R346): crawl, merge, cluster, dry run on a copy, report. It never writes to the repo tree.
# Written as a file only: do not install without the user's approval (timer install is task T80).
# Install (after approval): see README.md in this folder.
[Unit]
Description=islandlog newsfetch daily run (metadata only, 1 request per second per host, no change to public content)

[Service]
Type=oneshot
# ISLANDLOG_ARCHIVE_REPO and the other settings come from this file. Copy newsfetch.env.example to it and edit it.
EnvironmentFile=%h/.config/islandlog-newsfetch.env
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/sh -c 'cd "$ISLANDLOG_ARCHIVE_REPO" && exec /usr/bin/python3 -m tools.newsfetch.daily'
# Exit 75 means that another run holds the lock. It is not a failure of this run.
SuccessExitStatus=75
Nice=10
# The dry run takes about 55 minutes. The crawl and the clustering add about 1 hour. The limit leaves a margin.
TimeoutStartSec=6h
# Sandbox (T64 F-08). The run writes only below ~/islandlog-news. PrivateTmp is the Chromium temp dir.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=%h/islandlog-news
