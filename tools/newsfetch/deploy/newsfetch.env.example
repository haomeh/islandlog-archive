# Copy this file to ~/.config/islandlog-newsfetch.env and edit it. systemd reads it as KEY=value lines (no export, no quotes needed).
# A manual run: set -a; . ~/.config/islandlog-newsfetch.env; set +a; cd "$ISLANDLOG_ARCHIVE_REPO"; /usr/bin/python3 -m tools.newsfetch.daily

# Required. A clone of the archive repo. The daily layer only reads it (git archive of the base ref, git rev-parse, git status).
# The clone needs tools/newsfetch/node_modules (npm ci and the Playwright browser) for the click routes.
ISLANDLOG_ARCHIVE_REPO=/home/USER/islandlog/archive

# Required. A user service has a short default PATH. The click routes run node, the validator runs go.
# systemd does not expand ~, $HOME or %h in this file: write full paths. Check the paths with: command -v node go python3
# This host (node, go and python3 are under linuxbrew; node is also under nvm):
#   PATH=/home/linuxbrew/.linuxbrew/bin:/home/zh/.config/nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin

# Required under the service sandbox (T80, R358). The fetch step runs git over ssh. The sandbox makes ssh read /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf
# and reject it ("Bad owner or permissions"). This command skips the system ssh config and never asks for a password. The key must have no passphrase.
GIT_SSH_COMMAND=ssh -F /dev/null -o BatchMode=yes

# Required when the validator runs with "go run" (NEWSFETCH_SERVER_REPO). The sandbox writes only below ReadWritePaths, and the default Go cache is in ~/.cache.
# Use a folder below NEWSFETCH_DATA_DIR, or add the folder to ReadWritePaths. systemd does not expand ~: write the full path.
GOCACHE=/home/USER/islandlog-news/gocache

# Python: use /usr/bin/python3. A python3 first on PATH (linuxbrew) can be another version without the yaml module, and the key of a topic can depend on the version (T82-V G6).
# Optional. Defaults are shown.
# NEWSFETCH_DATA_DIR=/home/USER/islandlog-news
#   If you change it, add the new path to ReadWritePaths in a drop-in of the service (see README.md, step 4).
# NEWSFETCH_BASE_REF=origin/main
# NEWSFETCH_API_URL=http://localhost:8080
# Alert floor: a run with fewer new rows than this gives an alert.
# NEWSFETCH_MIN_NEW_ROWS=300
# Validator: a binary path, or a server repo (then the run uses "go run . validate"). With neither, the step is BLOCKED and gives an alert (R347.3).
# NEWSFETCH_VALIDATOR=/home/USER/bin/islandlog
# NEWSFETCH_SERVER_REPO=/home/USER/islandlog/server
# NEWSFETCH_PYTHON=/usr/bin/python3
