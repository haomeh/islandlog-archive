{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haomeh/islandlog-archive/schemas/taxonomy.schema.json",
  "title": "Taxonomy file",
  "description": "Applies to the seven taxonomy files that list slugs with Traditional Chinese labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "values"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "name": { "type": "string", "pattern": "^[a-z_]+$" },
    "description": { "type": "string" },
    "multi_valued": { "type": "boolean" },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "label_zh"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "label_zh": { "type": "string", "minLength": 1 },
          "scope_zh": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "computed": { "type": "boolean" },
          "inverse": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "allowed_grades": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/grade" } },
          "note": { "type": "string" }
        }
      }
    }
  },
  "x-uniqueSlug": "Slugs must be unique inside one file. JSON Schema cannot express this for object keys, so validate checks it."
}
